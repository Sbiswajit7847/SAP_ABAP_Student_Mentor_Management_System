REPORT ZGIFT_BS_REPROT.



TYPE-POOLS: SLIS.



TABLES: YGIFT_SINFO_BS, YGIFT_FINFO_BS.



TYPES: BEGIN OF TY_SINFO_BS,

         STUDENT_USN          TYPE YGIFT_SINFO_BS-GSI_BS_SUSN,

         STUDENT_NAME         TYPE YGIFT_SINFO_BS-GSI_BS_SNAME,

         STUDENT_ADDRESS1     TYPE YGIFT_SINFO_BS-GSI_BS_SADDR1,

         STUDENT_ADDRESS2     TYPE YGIFT_SINFO_BS-GSI_BS_SADDR2,

         STUDENT_MOBILE1      TYPE YGIFT_SINFO_BS-GSI_BS_SMOB1,

         STUDENT_EMOB2        TYPE YGIFT_SINFO_BS-GSI_BS_SEMOB2,

         STUDENT_BRANCH       TYPE YGIFT_SINFO_BS-GSI_BS_SBRANCH,

         STUDENT_MENTOR_NO    TYPE YGIFT_SINFO_BS-GSI_BS_SMNO,

         STUDENT_MENTOR_NAME  TYPE YGIFT_SINFO_BS-GSI_BS_SMNAME,

       END OF TY_SINFO_BS.





TYPES:BEGIN OF TY_FINFO_BS,

        FACULTY_ID         TYPE YGIFT_FINFO_BS-GFI_BS_EID,

        FACULTY_NAME       TYPE YGIFT_FINFO_BS-GFI_BS_ENAME,

        FACULTY_ADDRESS1   TYPE YGIFT_FINFO_BS-GFI_BS_EADDR1,

        FACULTY_ADDRESS2   TYPE YGIFT_FINFO_BS-GFI_BS_EADDR2,

        FACULTY_MOBILE1    TYPE YGIFT_FINFO_BS-GFI_BS_EMOB1,

        FACULTY_EMOBILE2   TYPE YGIFT_FINFO_BS-GFI_BS_EEMOB2,

        FACULTY_DEPARTMENT TYPE YGIFT_FINFO_BS-GIFT_BS_DCHECK,

      END OF TY_FINFO_BS.



TYPES: BEGIN OF TY_FINAL,

         STUDENT_USN         TYPE TY_SINFO_BS-STUDENT_USN,

         STUDENT_NAME        TYPE TY_SINFO_BS-STUDENT_NAME,

         STUDENT_ADDRESS     TYPE TY_SINFO_BS-STUDENT_ADDRESS1,

         STUDENT_MOBILE      TYPE TY_SINFO_BS-STUDENT_MOBILE1,

         STUDENT_BRANCH      TYPE TY_SINFO_BS-STUDENT_BRANCH,

         STUDENT_MENTOR_NO   TYPE TY_SINFO_BS-STUDENT_MENTOR_NO,

         STUDENT_MENTOR_NAME TYPE TY_SINFO_BS-STUDENT_MENTOR_NAME,

       END OF TY_FINAL.



DATA: IT_SINFO TYPE TABLE OF TY_SINFO_BS.

DATA: IT_FINFO TYPE TABLE OF TY_FINFO_BS.

DATA: IT_FINAL TYPE TABLE OF TY_FINAL.

DATA: IT_FLDCAT TYPE SLIS_T_FIELDCAT_ALV.



DATA: WA_SINFO TYPE TY_SINFO_BS.

DATA: WA_FINFO TYPE TY_FINFO_BS.

DATA: WA_FINAL TYPE TY_FINAL.

DATA: WA_FLDCAT TYPE SLIS_FIELDCAT_ALV.



SELECTION-SCREEN: BEGIN OF BLOCK A1 WITH FRAME TITLE TEXT-001.

SELECT-OPTIONS: S_ID FOR YGIFT_SINFO_BS-GSI_BS_SUSN OBLIGATORY.

SELECTION-SCREEN: END OF BLOCK A1.



START-OF-SELECTION.



  SELECT GSI_BS_SUSN

  GSI_BS_SNAME

  GSI_BS_SADDR1

  GSI_BS_SADDR2

  GSI_BS_SMOB1

  GSI_BS_SEMOB2

  GSI_BS_SBRANCH

  GSI_BS_SMNO

  GSI_BS_SMNAME

  FROM YGIFT_SINFO_BS INTO TABLE IT_SINFO

  WHERE GSI_BS_SUSN IN S_ID.



  IF SY-SUBRC EQ 0.

    SELECT

    GFI_BS_EID

    GFI_BS_ENAME

    GFI_BS_EADDR1

    GFI_BS_EADDR2

    GFI_BS_EMOB1

    GFI_BS_EEMOB2

    FROM YGIFT_FINFO_BS INTO TABLE IT_FINFO

    FOR ALL ENTRIES IN IT_SINFO WHERE GFI_BS_EID EQ IT_SINFO-STUDENT_MENTOR_NO.

  ENDIF.



  SORT: IT_SINFO, IT_FINFO.



END-OF-SELECTION.



  LOOP AT IT_SINFO INTO WA_SINFO.

    READ TABLE IT_FINFO INTO WA_FINFO

    WITH KEY FACULTY_ID = WA_SINFO-STUDENT_MENTOR_NO.



    IF SY-SUBRC EQ 0.



      WA_FINAL-STUDENT_USN = WA_SINFO-STUDENT_USN.

      WA_FINAL-STUDENT_NAME = WA_SINFO-STUDENT_NAME.

      WA_FINAL-STUDENT_ADDRESS = WA_SINFO-STUDENT_ADDRESS1.

      WA_FINAL-STUDENT_MOBILE = WA_SINFO-STUDENT_MOBILE1.

      WA_FINAL-STUDENT_BRANCH = WA_SINFO-STUDENT_BRANCH.

      WA_FINAL-STUDENT_MENTOR_NO = WA_SINFO-STUDENT_MENTOR_NO.

      WA_FINAL-STUDENT_MENTOR_NAME = WA_SINFO-STUDENT_MENTOR_NAME.





      APPEND WA_FINAL TO IT_FINAL.

    ENDIF.



    CLEAR: WA_SINFO, WA_FINFO.



    SORT: IT_FINAL.



  ENDLOOP.



  WA_FLDCAT-FIELDNAME = 'STUDENT_USN'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_USN'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_NAME'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_NAME'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_ADDRESS'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_ADDRESS'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_MOBILE'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_MOBILE'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_BRANCH'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_BRANCH'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_MENTOR_NO'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_MENTOR_NO'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



  WA_FLDCAT-FIELDNAME = 'STUDENT_MENTOR_NAME'.

  WA_FLDCAT-TABNAME = 'IT_SINFO'.

  WA_FLDCAT-SELTEXT_L = 'STUDENT_MENTOR_NAME'.

  APPEND WA_FLDCAT TO IT_FLDCAT.



